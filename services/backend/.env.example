# services/backend/.env.example

# Supabase (get from https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_TABLE_PATHWAY_DOCUMENTS=pathway_documents
SUPABASE_TABLE_PATHWAY_QUERIES=pathway_queries
# generic
# SUPABASE_MATCH_RPC=match_pathway_chunks

# minilm
# SUPABASE_MATCH_RPC=match_minilm_pathway_chunks

# mpnet
SUPABASE_MATCH_RPC=match_mpnet_pathway_chunks
# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Secret
JWT_SECRET=change-me-in-production
